@@ -0,0 +1,136 @@
+use axum::{
+    http::{header, HeaderValue, StatusCode},
+    response::{IntoResponse, Response},
+    Json,
+};
+use serde_json::json;
+
+/// Every error leaves the service in one shape: `{"error": {"code": "...", "message": "..."}}`.
+/// Messages are written for people, in the same plain language as the editor.
+#[derive(Debug)]
+pub struct ApiError {
+    status: StatusCode,
+    code: &'static str,
+    message: String,
+    retry_after_secs: Option<u32>,
+}
+
+impl ApiError {
+    fn new(status: StatusCode, code: &'static str, message: impl Into<String>) -> Self {
+        Self {
+            status,
+            code,
+            message: message.into(),
+            retry_after_secs: None,
+        }
+    }
+
+    pub fn invalid_json() -> Self {
+        Self::new(
+            StatusCode::BAD_REQUEST,
+            "invalid_json",
+            "That request wasn't valid JSON with an `operation` field.",
+        )
+    }
+
+    pub fn payload_too_large() -> Self {
+        Self::new(
+            StatusCode::PAYLOAD_TOO_LARGE,
+            "payload_too_large",
+            "That request is too large.",
+        )
+    }
+
+    pub fn invalid_body() -> Self {
+        Self::new(
+            StatusCode::BAD_REQUEST,
+            "invalid_body",
+            "That request couldn't be read.",
+        )
+    }
+
+    pub fn unknown_operation(requested: &str) -> Self {
+        // Echo a short, printable slice only; never reflect arbitrary input back verbatim.
+        let shown: String = requested
+            .chars()
+            .filter(|c| !c.is_control())
+            .take(40)
+            .collect();
+        Self::new(
+            StatusCode::BAD_REQUEST,
+            "unknown_operation",
+            format!("Pictoe doesn't know the operation \"{shown}\"."),
+        )
+    }
+
+    pub fn cloud_engine_unavailable() -> Self {
+        Self::new(
+            StatusCode::NOT_IMPLEMENTED,
+            "cloud_engine_unavailable",
+            "This tool needs Pictoe's cloud engine, which isn't available yet. Your current edits remain safe.",
+        )
+    }
+
+    pub fn invalid_job_id() -> Self {
+        Self::new(
+            StatusCode::BAD_REQUEST,
+            "invalid_job_id",
+            "That isn't a valid job id.",
+        )
+    }
+
+    pub fn job_not_found() -> Self {
+        Self::new(
+            StatusCode::NOT_FOUND,
+            "job_not_found",
+            "That job doesn't exist or has expired.",
+        )
+    }
+
+    pub fn job_already_finished() -> Self {
+        Self::new(
+            StatusCode::CONFLICT,
+            "job_already_finished",
+            "That job has already finished.",
+        )
+    }
+
+    pub fn too_many_jobs() -> Self {
+        let mut e = Self::new(
+            StatusCode::SERVICE_UNAVAILABLE,
+            "too_many_jobs",
+            "The cloud engine is busy. Try again in a moment. Your current edits remain safe.",
+        );
+        e.retry_after_secs = Some(5);
+        e
+    }
+
+    pub fn not_found() -> Self {
+        Self::new(
+            StatusCode::NOT_FOUND,
+            "not_found",
+            "There's nothing at that address.",
+        )
+    }
+
+    pub fn status(&self) -> StatusCode {
+        self.status
+    }
+
+    pub fn code(&self) -> &'static str {
+        self.code
+    }
+}
+
+impl IntoResponse for ApiError {
+    fn into_response(self) -> Response {
+        let body = Json(json!({ "error": { "code": self.code, "message": self.message } }));
+        let mut response = (self.status, body).into_response();
+        if let Some(secs) = self.retry_after_secs {
+            if let Ok(value) = HeaderValue::from_str(&secs.to_string()) {
+                response.headers_mut().insert(header::RETRY_AFTER, value);
+            }
+        }
+        response
+    }
+}
diff --git a/backend/src/jobs.rs b/backend/src/jobs.rs
new file mode 100644
index 0000000..172d814
--- /dev/null
+++ b/backend/src/jobs.rs
@@ -0,0 +1,216 @@
+use std::{
+    collections::HashMap,
+    sync::{Arc, Mutex, MutexGuard},
+    time::Duration,
+};
+
+use serde::Serialize;
+use tokio::{task::AbortHandle, time::Instant};
+use uuid::Uuid;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub enum JobStatus {
+    Queued,
+    Running,
+    Done,
+    Cancelled,
+}
+
+impl JobStatus {
+    pub fn is_finished(self) -> bool {
+        matches!(self, Self::Done | Self::Cancelled)
+    }
+}
+
+struct Record {
+    status: JobStatus,
+    finished_at: Option<Instant>,
+    abort: Option<AbortHandle>,
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum CancelOutcome {
+    Cancelled,
+    AlreadyFinished,
+    NotFound,
+}
+
+/// Too many jobs are already active.
+#[derive(Debug, PartialEq, Eq)]
+pub struct StoreFull;
+
+/// In-memory job lifecycle. Nothing here is persisted and nothing holds image data: a job is an
+/// id and a status. Real operations will replace the simulated `noop` work, behind the same API.
+#[derive(Clone)]
+pub struct JobStore {
+    jobs: Arc<Mutex<HashMap<Uuid, Record>>>,
+    max_jobs: usize,
+    ttl: Duration,
+}
+
+type Jobs = HashMap<Uuid, Record>;
+
+impl JobStore {
+    pub fn new(max_jobs: usize, ttl: Duration) -> Self {
+        Self {
+            jobs: Arc::new(Mutex::new(HashMap::new())),
+            max_jobs,
+            ttl,
+        }
+    }
+
+    /// A panic elsewhere must not take the whole service down, so recover a poisoned lock.
+    fn lock(&self) -> MutexGuard<'_, Jobs> {
+        self.jobs
+            .lock()
+            .unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+
+    fn expired(record: &Record, ttl: Duration) -> bool {
+        record.finished_at.is_some_and(|at| at.elapsed() >= ttl)
+    }
+
+    fn purge_expired(jobs: &mut Jobs, ttl: Duration) {
+        jobs.retain(|_, record| !Self::expired(record, ttl));
+    }
+
+    /// Starts a simulated job that takes `work` to finish. Only *active* jobs count against the
+    /// limit; finished ones are forgotten after the TTL, or sooner if memory needs the room.
+    pub fn create(&self, work: Duration) -> Result<Uuid, StoreFull> {
+        let mut jobs = self.lock();
+        Self::purge_expired(&mut jobs, self.ttl);
+
+        let active = jobs.values().filter(|r| !r.status.is_finished()).count();
+        if active >= self.max_jobs {
+            return Err(StoreFull);
+        }
+        while jobs.len() >= self.max_jobs {
+            let oldest = jobs
+                .iter()
+                .filter_map(|(id, r)| r.finished_at.map(|at| (*id, at)))
+                .min_by_key(|(_, at)| *at)
+                .map(|(id, _)| id);
+            match oldest {
+                Some(id) => {
+                    jobs.remove(&id);
+                }
+                None => break,
+            }
+        }
+
+        let id = Uuid::new_v4();
+        jobs.insert(
+            id,
+            Record {
+                status: JobStatus::Queued,
+                finished_at: None,
+                abort: None,
+            },
+        );
+
+        let store = self.clone();
+        let task = tokio::spawn(async move {
+            store.start(id);
+            tokio::time::sleep(work).await;
+            store.complete(id);
+        });
+        if let Some(record) = jobs.get_mut(&id) {
+            record.abort = Some(task.abort_handle());
+        }
+        Ok(id)
+    }
+
+    fn start(&self, id: Uuid) {
+        if let Some(record) = self.lock().get_mut(&id) {
+            if record.status == JobStatus::Queued {
+                record.status = JobStatus::Running;
+            }
+        }
+    }
+
+    fn complete(&self, id: Uuid) {
+        if let Some(record) = self.lock().get_mut(&id) {
+            if !record.status.is_finished() {
+                record.status = JobStatus::Done;
+                record.finished_at = Some(Instant::now());
+                record.abort = None;
+            }
+        }
+    }
+
+    pub fn status(&self, id: Uuid) -> Option<JobStatus> {
+        let mut jobs = self.lock();
+        if jobs.get(&id).is_some_and(|r| Self::expired(r, self.ttl)) {
+            jobs.remove(&id);
+        }
+        jobs.get(&id).map(|r| r.status)
+    }
+
+    pub fn cancel(&self, id: Uuid) -> CancelOutcome {
+        let mut jobs = self.lock();
+        if jobs.get(&id).is_some_and(|r| Self::expired(r, self.ttl)) {
+            jobs.remove(&id);
+        }
+        match jobs.get_mut(&id) {
+            None => CancelOutcome::NotFound,
+            Some(record) if record.status.is_finished() => CancelOutcome::AlreadyFinished,
+            Some(record) => {
+                if let Some(handle) = &record.abort {
+                    handle.abort();
+                }
+                record.status = JobStatus::Cancelled;
+                record.finished_at = Some(Instant::now());
+                CancelOutcome::Cancelled
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    impl JobStore {
+        /// Background tasks that are still running. Lets tests prove cancel really stops work.
+        fn tasks_in_flight(&self) -> usize {
+            self.lock()
+                .values()
+                .filter(|r| r.abort.as_ref().is_some_and(|handle| !handle.is_finished()))
+                .count()
+        }
+    }
+
+    async fn settle() {
+        for _ in 0..5 {
+            tokio::task::yield_now().await;
+        }
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn cancelling_stops_the_underlying_work() {
+        let store = JobStore::new(10, Duration::from_secs(60));
+        let id = store.create(Duration::from_secs(10)).unwrap();
+        settle().await;
+        assert_eq!(store.tasks_in_flight(), 1);
+
+        assert_eq!(store.cancel(id), CancelOutcome::Cancelled);
+        settle().await;
+        assert_eq!(
+            store.tasks_in_flight(),
+            0,
+            "the work must stop, not just be hidden"
+        );
+        assert_eq!(store.status(id), Some(JobStatus::Cancelled));
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn finished_work_leaves_nothing_running() {
+        let store = JobStore::new(10, Duration::from_secs(60));
+        store.create(Duration::from_millis(100)).unwrap();
+        settle().await;
+        tokio::time::advance(Duration::from_millis(150)).await;
+        settle().await;
+        assert_eq!(store.tasks_in_flight(), 0);
+    }
+}
diff --git a/backend/src/lib.rs b/backend/src/lib.rs
new file mode 100644
index 0000000..27e741b
--- /dev/null
+++ b/backend/src/lib.rs
@@ -0,0 +1,179 @@
+//! Pictoe's optional cloud gateway (B0 spike).
+//!
+//! The editor never depends on this service: editing, undo and export all run in the browser.
+//! This only exists for operations that cannot, behind a small job API. It deliberately contains
+//! no fake AI. Cloud-only operations are recognised and refused with an honest message, exactly
+//! as the editor's Intent Bar already does, and only the harmless `noop` operation exercises the
+//! job lifecycle (create, poll, cancel, expire).
+
+pub mod config;
+pub mod error;
+pub mod jobs;
+
+use std::time::Duration;
+
+use axum::{
+    body::Bytes,
+    extract::{rejection::BytesRejection, DefaultBodyLimit, Path, State},
+    http::{header, HeaderMap, HeaderValue, Method, StatusCode},
+    routing::get,
+    Json, Router,
+};
+use serde::{Deserialize, Serialize};
+use tower_http::{
+    cors::{AllowOrigin, CorsLayer},
+    timeout::TimeoutLayer,
+    trace::{DefaultMakeSpan, DefaultOnResponse, TraceLayer},
+};
+use tracing::Level;
+use uuid::Uuid;
+
+pub use config::Config;
+use error::ApiError;
+use jobs::{CancelOutcome, JobStatus, JobStore};
+
+/// Operations that need a real cloud model. Recognised, but not available yet.
+const CLOUD_ONLY: &[&str] = &[
+    "segment_subject",
+    "remove_object",
+    "replace_sky",
+    "expand_canvas",
+];
+
+#[derive(Clone)]
+struct AppState {
+    jobs: JobStore,
+    noop_duration: Duration,
+}
+
+#[derive(Serialize)]
+struct Health {
+    status: &'static str,
+    version: &'static str,
+}
+
+#[derive(Serialize)]
+struct JobView {
+    id: Uuid,
+    status: JobStatus,
+}
+
+#[derive(Deserialize)]
+struct CreateJob {
+    operation: String,
+}
+
+pub fn app(config: Config) -> Router {
+    let origins: Vec<HeaderValue> = config
+        .allowed_origins
+        .iter()
+        .filter_map(|o| HeaderValue::from_str(o).ok())
+        .collect();
+
+    let cors = CorsLayer::new()
+        .allow_origin(AllowOrigin::list(origins))
+        .allow_methods([Method::GET, Method::POST, Method::DELETE])
+        .allow_headers([header::CONTENT_TYPE])
+        .max_age(Duration::from_secs(600));
+
+    // Method, path, status and timing are logged. Request bodies never are.
+    let trace = TraceLayer::new_for_http()
+        .make_span_with(DefaultMakeSpan::new().level(Level::INFO))
+        .on_response(DefaultOnResponse::new().level(Level::INFO));
+
+    let state = AppState {
+        jobs: JobStore::new(config.max_jobs, config.finished_job_ttl),
+        noop_duration: config.noop_duration,
+    };
+
+    Router::new()
+        .route("/health", get(health))
+        .route("/jobs", axum::routing::post(create_job))
+        .route("/jobs/{id}", get(get_job).delete(cancel_job))
+        .fallback(|| async { ApiError::not_found() })
+        .layer(DefaultBodyLimit::max(config.max_body_bytes))
+        .layer(TimeoutLayer::with_status_code(
+            StatusCode::REQUEST_TIMEOUT,
+            config.request_timeout,
+        ))
+        // CORS sits outside everything so even error responses carry the right headers.
+        .layer(cors)
+        .layer(trace)
+        .with_state(state)
+}
+
+async fn health() -> Json<Health> {
+    Json(Health {
+        status: "ok",
+        version: env!("CARGO_PKG_VERSION"),
+    })
+}
+
+fn parse_id(raw: &str) -> Result<Uuid, ApiError> {
+    Uuid::parse_str(raw).map_err(|_| ApiError::invalid_job_id())
+}
+
+async fn create_job(
+    State(state): State<AppState>,
+    body: Result<Bytes, BytesRejection>,
+) -> Result<(StatusCode, HeaderMap, Json<JobView>), ApiError> {
+    let bytes = body.map_err(|rejection| {
+        if rejection.status() == StatusCode::PAYLOAD_TOO_LARGE {
+            ApiError::payload_too_large()
+        } else {
+            ApiError::invalid_body()
+        }
+    })?;
+    // Require a JSON object. Serde would otherwise also fill the struct from a bare list like
+    // ["noop"], which is not what this API means to accept.
+    let value: serde_json::Value =
+        serde_json::from_slice(&bytes).map_err(|_| ApiError::invalid_json())?;
+    if !value.is_object() {
+        return Err(ApiError::invalid_json());
+    }
+    let request: CreateJob = serde_json::from_value(value).map_err(|_| ApiError::invalid_json())?;
+
+    match request.operation.as_str() {
+        "noop" => {}
+        op if CLOUD_ONLY.contains(&op) => return Err(ApiError::cloud_engine_unavailable()),
+        other => return Err(ApiError::unknown_operation(other)),
+    }
+
+    let id = state
+        .jobs
+        .create(state.noop_duration)
+        .map_err(|_| ApiError::too_many_jobs())?;
+
+    let mut headers = HeaderMap::new();
+    if let Ok(location) = HeaderValue::from_str(&format!("/jobs/{id}")) {
+        headers.insert(header::LOCATION, location);
+    }
+    Ok((
+        StatusCode::ACCEPTED,
+        headers,
+        Json(JobView {
+            id,
+            status: JobStatus::Queued,
+        }),
+    ))
+}
+
+async fn get_job(
+    State(state): State<AppState>,
+    Path(raw): Path<String>,
+) -> Result<Json<JobView>, ApiError> {
+    let id = parse_id(&raw)?;
+    let status = state.jobs.status(id).ok_or_else(ApiError::job_not_found)?;
+    Ok(Json(JobView { id, status }))
+}
+
+async fn cancel_job(
+    State(state): State<AppState>,
+    Path(raw): Path<String>,
+) -> Result<StatusCode, ApiError> {
+    match state.jobs.cancel(parse_id(&raw)?) {
+        CancelOutcome::Cancelled => Ok(StatusCode::NO_CONTENT),
+        CancelOutcome::AlreadyFinished => Err(ApiError::job_already_finished()),
+        CancelOutcome::NotFound => Err(ApiError::job_not_found()),
+    }
+}
diff --git a/backend/src/main.rs b/backend/src/main.rs
new file mode 100644
index 0000000..41cbcdb
--- /dev/null
+++ b/backend/src/main.rs
@@ -0,0 +1,69 @@
+use std::process::ExitCode;
+
+use pictoe_api::{app, Config};
+use tokio::net::TcpListener;
+use tracing_subscriber::EnvFilter;
+
+#[tokio::main]
+async fn main() -> ExitCode {
+    tracing_subscriber::fmt()
+        .with_env_filter(
+            EnvFilter::try_from_default_env().unwrap_or_else(|_| EnvFilter::new("info")),
+        )
+        .init();
+
+    let config = match Config::from_lookup(|key| std::env::var(key).ok()) {
+        Ok(config) => config,
+        Err(error) => {
+            eprintln!("configuration error: {error}");
+            return ExitCode::from(2);
+        }
+    };
+
+    let listener = match TcpListener::bind(config.addr).await {
+        Ok(listener) => listener,
+        Err(error) => {
+            eprintln!("couldn't listen on {}: {error}", config.addr);
+            return ExitCode::from(1);
+        }
+    };
+
+    tracing::info!(addr = %config.addr, origins = ?config.allowed_origins, "pictoe-api listening");
+
+    match axum::serve(listener, app(config))
+        .with_graceful_shutdown(shutdown_signal())
+        .await
+    {
+        Ok(()) => {
+            tracing::info!("shut down cleanly");
+            ExitCode::SUCCESS
+        }
+        Err(error) => {
+            eprintln!("server error: {error}");
+            ExitCode::from(1)
+        }
+    }
+}
+
+/// Finish in-flight requests, then exit, on Ctrl-C or SIGTERM (what a container platform sends).
+async fn shutdown_signal() {
+    let ctrl_c = async {
+        let _ = tokio::signal::ctrl_c().await;
+    };
+
+    #[cfg(unix)]
+    let terminate = async {
+        if let Ok(mut signal) =
+            tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+        {
+            signal.recv().await;
+        }
+    };
+    #[cfg(not(unix))]
+    let terminate = std::future::pending::<()>();
+
+    tokio::select! {
+        _ = ctrl_c => {},
+        _ = terminate => {},
+    }
+}
diff --git a/backend/tests/api.rs b/backend/tests/api.rs
new file mode 100644
index 0000000..4d6c428
--- /dev/null
+++ b/backend/tests/api.rs
@@ -0,0 +1,324 @@
+//! Integration tests: the real router, driven in-process. Time is paused, so job durations and
+//! expiry are exact and the suite is fast and never flaky.
+
+use std::time::Duration;
+
+use axum::{
+    body::Body,
+    http::{header, HeaderMap, Method, Request, StatusCode},
+    Router,
+};
+use http_body_util::BodyExt;
+use pictoe_api::{app, Config};
+use serde_json::Value;
+use tower::ServiceExt;
+
+const ORIGIN: &str = "http://localhost:8080";
+
+fn config() -> Config {
+    Config {
+        noop_duration: Duration::from_millis(200),
+        allowed_origins: vec![ORIGIN.to_string()],
+        ..Config::default()
+    }
+}
+
+async fn call(app: &Router, request: Request<Body>) -> (StatusCode, HeaderMap, Value) {
+    let response = app.clone().oneshot(request).await.unwrap();
+    let (parts, body) = response.into_parts();
+    let bytes = body.collect().await.unwrap().to_bytes();
+    let json = serde_json::from_slice(&bytes).unwrap_or(Value::Null);
+    (parts.status, parts.headers, json)
+}
+
+fn post_job(body: &str) -> Request<Body> {
+    Request::builder()
+        .method(Method::POST)
+        .uri("/jobs")
+        .header(header::CONTENT_TYPE, "application/json")
+        .body(Body::from(body.to_string()))
+        .unwrap()
+}
+
+fn noop() -> Request<Body> {
+    post_job(r#"{"operation":"noop"}"#)
+}
+
+fn request(method: Method, uri: &str) -> Request<Body> {
+    Request::builder()
+        .method(method)
+        .uri(uri)
+        .body(Body::empty())
+        .unwrap()
+}
+
+async fn create(app: &Router) -> String {
+    let (status, _, body) = call(app, noop()).await;
+    assert_eq!(status, StatusCode::ACCEPTED);
+    body["id"].as_str().unwrap().to_string()
+}
+
+async fn status_of(app: &Router, id: &str) -> (StatusCode, Value) {
+    let (status, _, body) = call(app, request(Method::GET, &format!("/jobs/{id}"))).await;
+    (status, body)
+}
+
+/// Lets spawned job tasks run, then moves the paused clock forward.
+async fn pass(ms: u64) {
+    tokio::task::yield_now().await;
+    tokio::time::advance(Duration::from_millis(ms)).await;
+    tokio::task::yield_now().await;
+}
+
+fn code(body: &Value) -> &str {
+    body["error"]["code"].as_str().unwrap_or_default()
+}
+
+#[tokio::test]
+async fn health_reports_ok_and_a_version() {
+    let app = app(config());
+    let (status, _, body) = call(&app, request(Method::GET, "/health")).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(body["status"], "ok");
+    assert!(body["version"].as_str().is_some_and(|v| !v.is_empty()));
+}
+
+#[tokio::test(start_paused = true)]
+async fn a_job_goes_from_queued_to_running_to_done() {
+    let app = app(config());
+    let (status, headers, body) = call(&app, noop()).await;
+    assert_eq!(status, StatusCode::ACCEPTED);
+    assert_eq!(body["status"], "queued");
+    let id = body["id"].as_str().unwrap().to_string();
+    assert_eq!(headers[header::LOCATION], format!("/jobs/{id}"));
+
+    tokio::task::yield_now().await;
+    assert_eq!(status_of(&app, &id).await.1["status"], "running");
+
+    pass(250).await;
+    let (status, body) = status_of(&app, &id).await;
+    assert_eq!(status, StatusCode::OK);
+    assert_eq!(body["status"], "done");
+}
+
+#[tokio::test(start_paused = true)]
+async fn cancelling_a_running_job_stops_it_for_good() {
+    let app = app(config());
+    let id = create(&app).await;
+    tokio::task::yield_now().await;
+
+    let (status, _, _) = call(&app, request(Method::DELETE, &format!("/jobs/{id}"))).await;
+    assert_eq!(status, StatusCode::NO_CONTENT);
+    assert_eq!(status_of(&app, &id).await.1["status"], "cancelled");
+
+    pass(1000).await; // the aborted work must not flip it to "done"
+    assert_eq!(status_of(&app, &id).await.1["status"], "cancelled");
+}
+
+#[tokio::test(start_paused = true)]

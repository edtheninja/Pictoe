+import { WifiOff } from "lucide-react";
+import { useEditor } from "@/state/editor/EditorContext";
+
+export function HealPanel() {
+  const { state, applyEdit, setHealSource, setHealBrushSize, setHealBrushSoftness } = useEditor();
